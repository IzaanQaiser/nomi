# Copy to .env and fill in.
# Before you have a Gemini key, run with mock so ingest + shadowing
# plumbing can be tested end-to-end without any API calls:
#
#   LLM_PROVIDER=mock
#
# Then switch to gemini and set GEMINI_API_KEY. Sources are embedded ONCE
# at upload; chat and the live tutor reuse those vectors (NotebookLM-style).

# Provider: "mock" | "gemini" | "openai"
LLM_PROVIDER=mock

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- OpenAI (alternative) ---
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Production Supabase. Copy the Postgres connection string from Dashboard >
# Connect, and the service_role key from Settings > API. These belong ONLY on
# the backend server; never put them in the iOS project or commit backend/.env.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sources

# Local fallback (leave active when developing without Supabase):
DATABASE_URL=sqlite:///./ainotes.db
STORAGE_DIR=./storage

# Retrieval (embed once at ingest; query-time is cosine over stored vectors)
TOP_K=5
CHUNK_TOKENS=800
CHUNK_OVERLAP=120
FULL_CONTEXT_CHAR_BUDGET=48000
EMBED_DIM=768
